# Only products.php and orders.php are meant to be opened from the web
<FilesMatch "^(config|config\.sample|bootstrap|lib-courier|lib-meta|lib-landing|lib-geo)\.php$|\.json$|\.ini$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
Options -Indexes
